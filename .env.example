# Copy to .env.local and fill in locally. Placeholders only — never commit real values.

# Preview the UI as "guest" (default), "customer" (approved demo customer), "customer-pending"
# (applicant awaiting approval) or "admin".
# MOCK ONLY — this is not authentication and provides no security.
MOCK_VIEWER=guest

# Hostname that will serve product images from the future backend (enables next/image for it).
# NEXT_PUBLIC_MEDIA_HOST=media.example.com

# Switch from the demo's mock data to the REST backend. Leave unset until a backend exists; see docs/BACKEND-INTEGRATION-GUIDE.md.
# DATA_SOURCE=http
# API_BASE_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_API_BASE_URL is only a fallback, for browser code that must call the API. Never put a secret in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Hides the on-screen demo view switcher. Must be off in production.
# DEMO_VIEW_SWITCHER=off
